{
  "name": "labshare",
  "version": "0.1.0",
  "private": true,
  "description": "Shared lab facility platform: equipment booking, access control, usage review, automated invoicing and payments.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "jobs:run": "tsx scripts/run-jobs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.2.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "date-fns": "4.1.0",
    "jose": "5.9.6",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.0.6",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "prisma": "6.19.3",
    "tailwindcss": "4.0.6",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
