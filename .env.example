DATABASE_URL="postgresql://postgres:postgres@localhost:5432/labshare"
# Long random string used to sign login sessions
SESSION_SECRET="change-me-to-a-long-random-string"
# Shared secret for the scheduled automation endpoints (/api/cron/*)
CRON_SECRET="change-me"
APP_URL="http://localhost:3000"
# Optional: send real emails through Resend. Without it, emails are logged to the EmailLog table and console.
RESEND_API_KEY=""
EMAIL_FROM="LabShare Billing <billing@example.com>"
